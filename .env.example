# Discord application credentials
DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id

# Recommended for this single-server package: commands register instantly here.
# When this value is set, deploy:commands also removes old global commands so
# Discord does not show a global and guild copy of every slash command.
DISCORD_GUILD_ID=replace_with_your_test_server_id

# Bot identity
BOT_NAME=DevForge
BOT_STATUS=Building better software together
PRIMARY_COLOR=#5865F2
ACCENT_COLOR=#22D3EE

# Storage and HTTP server
DATABASE_PATH=./data/devforge.sqlite
PORT=3000

# Optional local/admin dashboard. Keep disabled unless a strong token is set.
DASHBOARD_ENABLED=false
DASHBOARD_TOKEN=
# Public URL used in dashboard and webhook instructions, for example https://bot.example.com
PUBLIC_BASE_URL=

# Optional GitHub integration
# Generate a long random value and use the same value in the GitHub webhook.
GITHUB_WEBHOOK_SECRET=
# Optional token raises GitHub API rate limits for /github repo.
GITHUB_TOKEN=
# Optional comma-separated allowlist, for example: openai/openai-node,owner/repo
GITHUB_REPOSITORY_FILTER=

# Logging: debug, info, warn, error
LOG_LEVEL=info
